# Privy (required)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Privy verification (optional)
PRIVY_VERIFICATION_KEY=
PRIVY_WALLET_AUTH_ID=
PRIVY_WALLET_AUTHORIZATION_PRIVATE_KEY=

# OpenAI Chat
OPENAI_API_KEY=sk-proj-...

# 0G / ZG storage
ZEROG_PRIVATE_KEY=0x...
ZEROG_ADDRESS=0x...
ZEROG_RPC_URL=https://evmrpc-testnet.0g.ai/
ZEROG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai/
ZEROG_STORAGE_FEE_WEI=1000000000000

# CDP
CDP_API_KEY_NAME=
CDP_API_KEY_SECRET=

# Uniswap
UNISWAP_API_KEY=

# RPC / contracts
USDC_CONTRACT_SEPOLIA=0x...
ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 0G provider (ZG_*)
ZG_PRIVATE_KEY=0x...
ZG_NETWORK=testnet
ZG_RPC_URL=https://evmrpc-testnet.0g.ai/
ZG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai/
ZG_KV_RPC=
ZG_STREAM_ID=0x...
ZG_ADDRESS=0x...

# 0x Swap
ZEROX_API_KEY=

# Alchemy (optional)
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Jupiter / Solana
JUPITER_API_KEY=
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# Optional WebSocket override; if unset, derived from HTTP URL
# NEXT_PUBLIC_SOLANA_RPC_WS=wss://...
